X-WR-TIMEZONE:America/New_York
REFRESH-INTERVAL;VALUE=DURATION:PT12H
X-PUBLISHED-TTL:PT12H
BEGIN:VEVENT
UID:example-monstera-20260919@plant-care
DTSTAMP:20260919T134632Z
DTSTART;VALUE=DATE:20260919
DTEND;VALUE=DATE:20260920
SUMMARY:Water Monstera (example)
DESCRIPTION:500 ml — about 2 cups\nWater slowly until it drains from the 
 bottom\, then empty the saucer\nLight: Bright indirect light\nWhere: Livin
 g room\, 6 ft from the south window\nWatch for: Yellow lower leaves = over
 watered. Crispy brown edges = too dry or low humidity. Drooping = thirsty.
 \nNotes: Rotate a quarter turn each watering so it grows evenly. Wipe leav
 es monthly.\nLog it: https://nsfogg.github.io/plant_watering/#today
TRANSP:TRANSPARENT
BEGIN:VALARM
TRIGGER;RELATED=START:PT8H
ACTION:DISPLAY
DESCRIPTION:Water Monstera (example) — 500 ml — about 2 cups
END:VALARM
END:VEVENT
